{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    // 增量状态放忽略目录：命中缓存时 tsc 只对比文件图，不重算全部类型。
    "incremental": true,
    "tsBuildInfoFile": "./.artifacts/cache/ts/platform.tsbuildinfo",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/main-desktop.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/platform/**/*.ts",
    "src/preview/**/*.ts",
    "src/preview/**/*.tsx",
    "src-tauri/src/domain/bindings/**/*.ts",
    "src/main-web.tsx"
  ]
}
