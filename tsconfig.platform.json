{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/main-desktop.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/platform/**/*.ts",
    "src/preview/**/*.ts",
    "src/preview/**/*.tsx",
    "src-tauri/src/domain/bindings/**/*.ts",
    "src/main-web.tsx"
  ]
}
