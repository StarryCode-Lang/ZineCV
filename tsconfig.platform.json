{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "types": ["vite/client"]
  },
  "include": [
    "src/platform/**/*.ts",
    "src/bridge/**/*.ts",
    "src-tauri/src/domain/bindings/**/*.ts"
  ]
}
