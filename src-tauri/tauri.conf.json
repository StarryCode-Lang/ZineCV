{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZineCV",
  "version": "2.0.0-alpha.0",
  "identifier": "com.zinecv.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5174 --strictPort",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZineCV",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' zinecv-font: http://zinecv-font.localhost https://zinecv-font.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "resources": {
      "../docs/licenses/": "licenses/",
      "../NOTICE.txt": "NOTICE.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
