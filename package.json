{
  "name": "zinecv-desktop",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Isolated ZineCV desktop implementation",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 dev",
    "build": "vite build",
    "check:ts": "tsc --noEmit -p tsconfig.platform.json",
    "check:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 check",
    "test:unit": "node --test --import ./tests/unit/register-ts-resolve.mjs tests/unit/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tools/browser-regression.test.mjs",
    "test:bindings": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 bindings && node tools/verify-bindings.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 test",
    "test:native-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 hooks-test",
    "build:native-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 hooks-build",
    "test:webview-hooks": "node --test --test-concurrency=1 tests/native/webview-hooks.test.mjs tests/native/webview-permissions.test.mjs",
    "test:engine-poc": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 poc-test",
    "test:engine-worker": "node --test tests/native/typst-worker-poc.test.mjs",
    "test:native-shell": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/native/shell-smoke.ps1",
    "test:webview": "node --test --test-concurrency=1 tests/native/webview.test.mjs tests/native/webview-modules.test.mjs tests/native/webview-editor-contracts.test.mjs",
    "test:webview-migration": "node --test tests/native/webview-migration.test.mjs",
    "test:webview-migration-crash": "node tools/test-migration-crash.mjs",
    "test:webview-proposal-assets": "node --test tests/native/webview-proposal-assets.test.mjs",
    "test:webview-agent-ui": "node --test --test-concurrency=1 tests/native/webview-agent-ui.test.mjs tests/native/webview-agent-closure.test.mjs",
    "test:webview-persistence": "node --test tests/native/webview-persistence.test.mjs",
    "test:webview-publication": "node --test --test-concurrency=1 tests/native/webview-publication.test.mjs",
    "test:visual-parity": "node --test tools/visual-parity.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 build",
    "build:engine-poc": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 poc-release",
    "build:engine-render": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 engine-render-release",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 bundle",
    "verify:contracts": "node tools/verify-contracts.mjs",
    "verify:fixtures": "node tools/generate-remaining-fixtures.mjs --check",
    "verify:licenses": "node tools/generate-resource-license-inventory.mjs --check",
    "verify:project": "node tools/verify-project.mjs",
    "test:webview-preview": "node --test --test-concurrency=1 tests/native/webview-preview.test.mjs tests/native/webview-closure.test.mjs tests/native/webview-closure-controls.test.mjs tests/native/webview-closure-interactions.test.mjs tests/native/webview-multipage.test.mjs",
    "test:webview-fit": "node --test --test-concurrency=1 tests/native/webview-fit.test.mjs tests/native/webview-fit-ui.test.mjs",
    "test:webview-export": "node --test --test-concurrency=1 tests/native/webview-export.test.mjs tests/native/webview-export-dpi.test.mjs",
    "test:webview-fonts": "node --test --test-concurrency=1 tests/native/webview-fonts.test.mjs tests/native/webview-font-selection.test.mjs",
    "test:webview-supplemental": "node --test tests/native/webview-supplemental.test.mjs",
    "test:lightweight": "node --test tools/lightweight/measure-memory.test.mjs",
    "test:webview-fit-faults": "node --test tests/native/webview-fit-faults.test.mjs",
    "audit:ast": "node tools/audit-ast.mjs",
    "build:web": "node tools/build-web.mjs",
    "test:web-core": "node --test --test-concurrency=1 tools/web-core-poc.test.mjs tools/web-store-poc.test.mjs tools/web-agent-poc.test.mjs",
    "test:web-product": "node --test tools/web-product.test.mjs",
    "build:ohos-core": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 ohos-build",
    "test:ohos-core": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 ohos-test",
    "test:platform-parity": "node --test tools/platform-parity.test.mjs",
    "check:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/with-msvc.ps1 wasm-check",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-checks.ps1",
    "check:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-checks.ps1 -Scope UI",
    "accept:full": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-remaining-checks.ps1 -Complete",
    "check:regression": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-checks.ps1 -Scope Regression",
    "check:remaining": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-remaining-checks.ps1"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "docx-preview": "^0.4.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "motion": "^13.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2"
  }
}
